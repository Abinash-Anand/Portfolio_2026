{
  "name": "portfolio-2026",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"scripts/**/*.ts\"",
    "sync": "tsx scripts/sync-github.ts",
    "sync:record-fixture": "tsx scripts/record-fixture.ts",
    "postinstall": "tsx scripts/sync-github.ts --if-missing",
    "prestart": "npm run sync",
    "prebuild": "npm run sync",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test:scripts": "vitest run --config vitest.scripts.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.24",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@shikijs/rehype": "^4.4.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.6.3",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "hast-util-to-string": "^3.0.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.0.8",
    "zod": "^4.6.5"
  }
}
